read_vdj_build <- function(path) {
  obj <- readRDS(path)

  if (is.data.frame(obj)) {
    df <- as_tibble(obj)
  } else if (is.list(obj) && "VDJ" %in% names(obj) && is.data.frame(obj$VDJ)) {
    df <- as_tibble(obj$VDJ)
  } else {
    stop("Unsupported RDS structure in: ", path)
  }

  df %>%
    mutate(
      source_file = path,
      source_dir_sample = basename(dirname(path))
    )
}

