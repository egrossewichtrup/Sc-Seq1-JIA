split_indices_into_chunks <- function(n, chunk_size) {
  if (n == 0) return(list())
  split(seq_len(n), ceiling(seq_len(n) / chunk_size))
}

extract_best_counts <- function(counts_array, best_j, aliases) {
  if (is.null(counts_array)) {
    return(rep(NA_integer_, length(best_j)))
  }

  nm <- dimnames(counts_array)[[3]]

  if (is.null(nm)) {
    return(rep(NA_integer_, length(best_j)))
  }

  hit <- intersect(aliases, nm)

  if (length(hit) == 0) {
    return(rep(NA_integer_, length(best_j)))
  }

  k <- match(hit[1], nm)

  as.integer(
    counts_array[cbind(seq_along(best_j), best_j, rep(k, length(best_j)))]
  )
}

seqs_to_char_matrix <- function(seqs) {
  if (length(seqs) == 0) {
    return(matrix(character(0), nrow = 0, ncol = 0))
  }

  split_list <- strsplit(seqs, "", fixed = TRUE)
  lens <- lengths(split_list)

  if (length(unique(lens)) != 1) {
    stop("seqs_to_char_matrix received sequences of different lengths.")
  }

  out <- do.call(rbind, split_list)
  mode(out) <- "character"
  out
}

same_length_best_match_chunk <- function(query_seqs, db_seqs, match_metric = c("identity", "conservative")) {
  match_metric <- match.arg(match_metric)

  if (length(query_seqs) == 0 || length(db_seqs) == 0) {
    return(tibble())
  }

  qmat <- seqs_to_char_matrix(query_seqs)
  dmat <- seqs_to_char_matrix(db_seqs)

  if (ncol(qmat) != ncol(dmat)) {
    stop("same_length_best_match_chunk received query and db sequences of different lengths.")
  }

  seq_len_used <- ncol(qmat)

  qgroup <- matrix(
    aa_group(as.vector(qmat)),
    nrow = nrow(qmat),
    ncol = ncol(qmat)
  )

  dgroup <- matrix(
    aa_group(as.vector(dmat)),
    nrow = nrow(dmat),
    ncol = ncol(dmat)
  )

  out_list <- vector("list", nrow(qmat))

  for (i in seq_len(nrow(qmat))) {
    qrow <- qmat[i, ]
    qgroup_row <- qgroup[i, ]

    qrow_mat <- matrix(
      qrow,
      nrow = nrow(dmat),
      ncol = seq_len_used,
      byrow = TRUE
    )

    qgroup_mat <- matrix(
      qgroup_row,
      nrow = nrow(dgroup),
      ncol = seq_len_used,
      byrow = TRUE
    )

    exact_vec <- rowSums(dmat == qrow_mat)

    conservative_vec <- rowSums(
      dmat != qrow_mat &
        dgroup == qgroup_mat
    )

    nonconservative_vec <- rowSums(
      dmat != qrow_mat &
        dgroup != qgroup_mat
    )

    exact_fraction_vec <- exact_vec / seq_len_used
    conservative_plus_exact_vec <- (exact_vec + conservative_vec) / seq_len_used

    score_vec <- if (match_metric == "identity") {
      exact_fraction_vec
    } else {
      conservative_plus_exact_vec
    }

    ranking_tbl <- tibble(
      j = seq_along(score_vec),
      score = score_vec,
      exact = exact_vec,
      conservative = conservative_vec
    ) %>%
      arrange(desc(score), desc(exact), desc(conservative), j)

    best_j <- ranking_tbl$j[1]

    out_list[[i]] <- tibble(
      best_j = best_j,
      best_similarity = score_vec[best_j],
      aa_differences = seq_len_used - exact_vec[best_j],
      exact_match_count = exact_vec[best_j],
      conservative_nonidentical_count = conservative_vec[best_j],
      nonconservative_count = nonconservative_vec[best_j],
      exact_fraction_same_length = exact_fraction_vec[best_j],
      conservative_plus_exact_fraction = conservative_plus_exact_vec[best_j]
    )
  }

  bind_rows(out_list)
}

run_same_length_screen <- function(
    query_tbl,
    db_tbl,
    require_same_ighv = FALSE,
    chunk_size = 300,
    match_metric = c("identity", "conservative")
) {
  match_metric <- match.arg(match_metric)

  if (nrow(query_tbl) == 0) {
    return(tibble())
  }

  bucket_vars <- c("query_length")
  if (require_same_ighv) {
    bucket_vars <- c(bucket_vars, "heavy_v_gene")
  }

  split_key <- do.call(
    interaction,
    c(query_tbl[bucket_vars], list(drop = TRUE, lex.order = TRUE))
  )

  query_split <- split(query_tbl, split_key)

  map_dfr(query_split, function(qb) {
    qlen <- unique(qb$query_length)

    db_bucket <- db_tbl %>%
      filter(hcdr3_length == qlen)

    if (require_same_ighv) {
      gene <- unique(qb$heavy_v_gene)
      db_bucket <- db_bucket %>%
        filter(heavy_v_gene == gene)
    }

    if (nrow(db_bucket) == 0) {
      return(
        qb %>%
          transmute(
            query_hcdr3 = hcdr3,
            query_length = query_length,
            heavy_v_gene = if ("heavy_v_gene" %in% colnames(qb)) heavy_v_gene else NA_character_,
            best_db_hcdr3 = NA_character_,
            best_db_length = NA_integer_,
            best_similarity = NA_real_,
            aa_differences = NA_integer_,
            exact_match_count = NA_integer_,
            conservative_nonidentical_count = NA_integer_,
            nonconservative_count = NA_integer_,
            exact_fraction_same_length = NA_real_,
            conservative_plus_exact_fraction = NA_real_,
            matched_covabdab_names = NA_character_,
            matched_covabdab_targets = NA_character_,
            matched_covabdab_neutralising_vs = NA_character_,
            matched_covabdab_epitopes = NA_character_,
            matched_covabdab_origins = NA_character_,
            n_cells_in_your_data = n_cells_in_your_data,
            n_samples_in_your_data = n_samples_in_your_data,
            n_patients_in_your_data = n_patients_in_your_data,
            sample_ids_in_your_data = sample_ids_in_your_data,
            patient_ids_in_your_data = patient_ids_in_your_data,
            tissues_in_your_data = tissues_in_your_data,
            sides_in_your_data = sides_in_your_data,
            isotypes_in_your_data = isotypes_in_your_data,
            clonotype_ids_in_your_data = clonotype_ids_in_your_data,
            clonotype_ids_10x_in_your_data = clonotype_ids_10x_in_your_data,
            max_clonotype_frequency_in_your_data = max_clonotype_frequency_in_your_data
          )
      )
    }

    chunk_list <- split_indices_into_chunks(nrow(qb), chunk_size)

    map_dfr(chunk_list, function(ix) {
      qs <- qb[ix, , drop = FALSE]

      best_tbl <- same_length_best_match_chunk(
        query_seqs = qs$hcdr3,
        db_seqs = db_bucket$hcdr3,
        match_metric = match_metric
      )

      best_db <- db_bucket[best_tbl$best_j, , drop = FALSE]

      tibble(
        query_hcdr3 = qs$hcdr3,
        query_length = qs$query_length,
        heavy_v_gene = if ("heavy_v_gene" %in% colnames(qs)) qs$heavy_v_gene else NA_character_,
        best_db_hcdr3 = best_db$hcdr3,
        best_db_length = best_db$hcdr3_length,
        matched_covabdab_names = best_db$matched_covabdab_names,
        matched_covabdab_targets = best_db$matched_covabdab_targets,
        matched_covabdab_neutralising_vs = best_db$matched_covabdab_neutralising_vs,
        matched_covabdab_epitopes = best_db$matched_covabdab_epitopes,
        matched_covabdab_origins = best_db$matched_covabdab_origins,
        n_cells_in_your_data = qs$n_cells_in_your_data,
        n_samples_in_your_data = qs$n_samples_in_your_data,
        n_patients_in_your_data = qs$n_patients_in_your_data,
        sample_ids_in_your_data = qs$sample_ids_in_your_data,
        patient_ids_in_your_data = qs$patient_ids_in_your_data,
        tissues_in_your_data = qs$tissues_in_your_data,
        sides_in_your_data = qs$sides_in_your_data,
        isotypes_in_your_data = qs$isotypes_in_your_data,
        clonotype_ids_in_your_data = qs$clonotype_ids_in_your_data,
        clonotype_ids_10x_in_your_data = qs$clonotype_ids_10x_in_your_data,
        max_clonotype_frequency_in_your_data = qs$max_clonotype_frequency_in_your_data
      ) %>%
        bind_cols(best_tbl %>% select(-best_j))
    })
  }) %>%
    arrange(desc(best_similarity), desc(n_cells_in_your_data), query_hcdr3)
}

run_targeted_indel_screen <- function(
    query_tbl,
    db_tbl,
    require_same_ighv = FALSE,
    max_length_difference = 1,
    chunk_size = 150
) {
  if (nrow(query_tbl) == 0) {
    return(tibble())
  }

  bucket_vars <- c("query_length")
  if (require_same_ighv) {
    bucket_vars <- c(bucket_vars, "heavy_v_gene")
  }

  split_key <- do.call(
    interaction,
    c(query_tbl[bucket_vars], list(drop = TRUE, lex.order = TRUE))
  )

  query_split <- split(query_tbl, split_key)

  map_dfr(query_split, function(qb) {
    qlen <- unique(qb$query_length)

    db_bucket <- db_tbl %>%
      filter(abs(hcdr3_length - qlen) <= max_length_difference)

    if (require_same_ighv) {
      gene <- unique(qb$heavy_v_gene)
      db_bucket <- db_bucket %>%
        filter(heavy_v_gene == gene)
    }

    if (nrow(db_bucket) == 0) {
      return(
        qb %>%
          transmute(
            query_hcdr3 = hcdr3,
            query_length = query_length,
            heavy_v_gene = if ("heavy_v_gene" %in% colnames(qb)) heavy_v_gene else NA_character_,
            best_db_hcdr3 = NA_character_,
            best_db_length = NA_integer_,
            best_similarity = NA_real_,
            total_edit_ops = NA_integer_,
            n_substitutions = NA_integer_,
            n_insertions = NA_integer_,
            n_deletions = NA_integer_,
            length_difference = NA_integer_,
            exact_match_count = NA_integer_,
            conservative_nonidentical_count = NA_integer_,
            nonconservative_count = NA_integer_,
            exact_fraction_same_length = NA_real_,
            conservative_plus_exact_fraction = NA_real_,
            matched_covabdab_names = NA_character_,
            matched_covabdab_targets = NA_character_,
            matched_covabdab_neutralising_vs = NA_character_,
            matched_covabdab_epitopes = NA_character_,
            matched_covabdab_origins = NA_character_,
            n_cells_in_your_data = n_cells_in_your_data,
            n_samples_in_your_data = n_samples_in_your_data,
            n_patients_in_your_data = n_patients_in_your_data,
            sample_ids_in_your_data = sample_ids_in_your_data,
            patient_ids_in_your_data = patient_ids_in_your_data,
            tissues_in_your_data = tissues_in_your_data,
            sides_in_your_data = sides_in_your_data,
            isotypes_in_your_data = isotypes_in_your_data,
            clonotype_ids_in_your_data = clonotype_ids_in_your_data,
            clonotype_ids_10x_in_your_data = clonotype_ids_10x_in_your_data,
            max_clonotype_frequency_in_your_data = max_clonotype_frequency_in_your_data
          )
      )
    }

    chunk_list <- split_indices_into_chunks(nrow(qb), chunk_size)

    map_dfr(chunk_list, function(ix) {
      qs <- qb[ix, , drop = FALSE]

      dmat <- utils::adist(qs$hcdr3, db_bucket$hcdr3, counts = TRUE)
      counts_array <- attr(dmat, "counts")

      denom_mat <- matrix(
        pmax(qs$query_length[1], db_bucket$hcdr3_length),
        nrow = nrow(dmat),
        ncol = ncol(dmat),
        byrow = TRUE
      )

      sim_mat <- 1 - (dmat / denom_mat)

      best_j <- max.col(sim_mat, ties.method = "first")

      best_dist <- as.integer(dmat[cbind(seq_len(nrow(dmat)), best_j)])
      best_sim <- as.numeric(sim_mat[cbind(seq_len(nrow(sim_mat)), best_j)])

      best_sub <- extract_best_counts(
        counts_array = counts_array,
        best_j = best_j,
        aliases = c("substitutions", "subs", "sub")
      )

      best_ins <- extract_best_counts(
        counts_array = counts_array,
        best_j = best_j,
        aliases = c("insertions", "ins", "insert")
      )

      best_del <- extract_best_counts(
        counts_array = counts_array,
        best_j = best_j,
        aliases = c("deletions", "del", "delete")
      )

      best_db <- db_bucket[best_j, , drop = FALSE]

      pos_metrics <- map2_dfr(
        qs$hcdr3,
        best_db$hcdr3,
        same_length_position_metrics
      )

      tibble(
        query_hcdr3 = qs$hcdr3,
        query_length = qs$query_length,
        heavy_v_gene = if ("heavy_v_gene" %in% colnames(qs)) qs$heavy_v_gene else NA_character_,
        best_db_hcdr3 = best_db$hcdr3,
        best_db_length = best_db$hcdr3_length,
        best_similarity = best_sim,
        total_edit_ops = best_dist,
        n_substitutions = best_sub,
        n_insertions = best_ins,
        n_deletions = best_del,
        length_difference = abs(qs$query_length - best_db$hcdr3_length),
        matched_covabdab_names = best_db$matched_covabdab_names,
        matched_covabdab_targets = best_db$matched_covabdab_targets,
        matched_covabdab_neutralising_vs = best_db$matched_covabdab_neutralising_vs,
        matched_covabdab_epitopes = best_db$matched_covabdab_epitopes,
        matched_covabdab_origins = best_db$matched_covabdab_origins,
        n_cells_in_your_data = qs$n_cells_in_your_data,
        n_samples_in_your_data = qs$n_samples_in_your_data,
        n_patients_in_your_data = qs$n_patients_in_your_data,
        sample_ids_in_your_data = qs$sample_ids_in_your_data,
        patient_ids_in_your_data = qs$patient_ids_in_your_data,
        tissues_in_your_data = qs$tissues_in_your_data,
        sides_in_your_data = qs$sides_in_your_data,
        isotypes_in_your_data = qs$isotypes_in_your_data,
        clonotype_ids_in_your_data = qs$clonotype_ids_in_your_data,
        clonotype_ids_10x_in_your_data = qs$clonotype_ids_10x_in_your_data,
        max_clonotype_frequency_in_your_data = qs$max_clonotype_frequency_in_your_data
      ) %>%
        bind_cols(pos_metrics)
    })
  }) %>%
    arrange(desc(best_similarity), desc(n_cells_in_your_data), query_hcdr3)
}

make_threshold_summary <- function(tbl, comparison_name, thresholds) {
  total_entries <- nrow(tbl)
  total_cells <- sum(as_num_safe(tbl$n_cells_in_your_data), na.rm = TRUE)

  map_dfr(thresholds, function(thr) {
    keep <- !is.na(tbl$best_similarity) & tbl$best_similarity >= thr

    tibble(
      comparison = comparison_name,
      similarity_threshold = thr,
      similarity_threshold_pct = 100 * thr,
      n_query_entries_total = total_entries,
      n_query_entries_with_match = sum(keep),
      pct_query_entries_with_match = ifelse(
        total_entries > 0,
        100 * sum(keep) / total_entries,
        NA_real_
      ),
      n_query_cells_total = total_cells,
      n_query_cells_covered_by_hit_queries = sum(as_num_safe(tbl$n_cells_in_your_data)[keep], na.rm = TRUE),
      pct_query_cells_covered_by_hit_queries = ifelse(
        total_cells > 0,
        100 * sum(as_num_safe(tbl$n_cells_in_your_data)[keep], na.rm = TRUE) / total_cells,
        NA_real_
      ),
      min_query_length_among_hits = safe_min(tbl$query_length, keep),
      max_query_length_among_hits = safe_max(tbl$query_length, keep),
      min_aa_differences_among_hits = if ("aa_differences" %in% colnames(tbl)) safe_min(tbl$aa_differences, keep) else NA_real_,
      max_aa_differences_among_hits = if ("aa_differences" %in% colnames(tbl)) safe_max(tbl$aa_differences, keep) else NA_real_,
      min_total_edit_ops_among_hits = if ("total_edit_ops" %in% colnames(tbl)) safe_min(tbl$total_edit_ops, keep) else NA_real_,
      max_total_edit_ops_among_hits = if ("total_edit_ops" %in% colnames(tbl)) safe_max(tbl$total_edit_ops, keep) else NA_real_,
      min_conservative_nonidentical_count_among_hits =
        if ("conservative_nonidentical_count" %in% colnames(tbl)) safe_min(tbl$conservative_nonidentical_count, keep) else NA_real_,
      max_conservative_nonidentical_count_among_hits =
        if ("conservative_nonidentical_count" %in% colnames(tbl)) safe_max(tbl$conservative_nonidentical_count, keep) else NA_real_,
      min_nonconservative_count_among_hits =
        if ("nonconservative_count" %in% colnames(tbl)) safe_min(tbl$nonconservative_count, keep) else NA_real_,
      max_nonconservative_count_among_hits =
        if ("nonconservative_count" %in% colnames(tbl)) safe_max(tbl$nonconservative_count, keep) else NA_real_
    )
  })
}

