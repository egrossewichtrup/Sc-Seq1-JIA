aa_group <- function(x) {
  case_when(
    x %in% c("K", "R", "H") ~ "positive",
    x %in% c("D", "E") ~ "negative",
    x %in% c("S", "T", "N", "Q") ~ "polar",
    x %in% c("A", "V", "I", "L", "M") ~ "aliphatic",
    x %in% c("F", "Y", "W") ~ "aromatic",
    x == "C" ~ "cysteine",
    x == "G" ~ "glycine",
    x == "P" ~ "proline",
    TRUE ~ "other"
  )
}

same_length_position_metrics <- function(query_seq, db_seq) {
  if (is.na(query_seq) || is.na(db_seq)) {
    return(tibble(
      exact_match_count = NA_integer_,
      conservative_nonidentical_count = NA_integer_,
      nonconservative_count = NA_integer_,
      exact_fraction_same_length = NA_real_,
      conservative_plus_exact_fraction = NA_real_
    ))
  }

  if (nchar(query_seq) != nchar(db_seq)) {
    return(tibble(
      exact_match_count = NA_integer_,
      conservative_nonidentical_count = NA_integer_,
      nonconservative_count = NA_integer_,
      exact_fraction_same_length = NA_real_,
      conservative_plus_exact_fraction = NA_real_
    ))
  }

  q <- strsplit(query_seq, "", fixed = TRUE)[[1]]
  d <- strsplit(db_seq, "", fixed = TRUE)[[1]]

  exact_match_count <- sum(q == d)

  conservative_nonidentical_count <- sum(
    q != d &
      aa_group(q) == aa_group(d)
  )

  nonconservative_count <- sum(
    q != d &
      aa_group(q) != aa_group(d)
  )

  seq_len_used <- length(q)

  tibble(
    exact_match_count = exact_match_count,
    conservative_nonidentical_count = conservative_nonidentical_count,
    nonconservative_count = nonconservative_count,
    exact_fraction_same_length = exact_match_count / seq_len_used,
    conservative_plus_exact_fraction =
      (exact_match_count + conservative_nonidentical_count) / seq_len_used
  )
}

