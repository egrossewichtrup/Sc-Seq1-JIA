first_nonempty_token <- function(x) {
  if (is.na(x) || x == "") return(NA_character_)

  parts <- str_split(as.character(x), ";", simplify = TRUE) %>%
    as.character() %>%
    str_trim()

  parts <- parts[parts != ""]
  if (length(parts) == 0) return(NA_character_)

  parts[1]
}

first_token_with_prefix <- function(x, prefix = "IGHV") {
  if (is.na(x) || x == "") return(NA_character_)

  parts <- str_split(as.character(x), ";", simplify = TRUE) %>%
    as.character() %>%
    str_trim()

  parts <- parts[parts != ""]
  if (length(parts) == 0) return(NA_character_)

  pref <- parts[str_starts(str_to_upper(parts), str_to_upper(prefix))]

  if (length(pref) > 0) {
    pref[1]
  } else {
    parts[1]
  }
}

